{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".source/**", "bundle/**", "dist/**"]
    },
    "build:vercel": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "vercel-bundle/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    // Same as "dev" but skips the portless wrapper, so both apps bind the fixed ports in .env
    // (api 4000, web 3000) instead of portless-assigned ones. Used by `bun run dev:local`.
    "dev:app": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "start": {
      "persistent": true,
      "cache": false
    }
  },
  "globalDependencies": [
    ".env*",
    "data/*.json",
    // build-time generators (font metrics, env derivation): a build cached before an edit here would ship their stale output
    "packages/scripts/src/**"
  ],
  "globalEnv": [
    // CI variables
    "SKIP_ENV_VALIDATION",
    "SKIP_ENV_VALIDATION_SERVER",
    // Server variables
    "NODE_ENV",
    "BETTER_AUTH_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "HONO_APP_URL",
    "HONO_PORT",
    "HONO_RATE_LIMIT",
    "HONO_RATE_LIMIT_WINDOW_MS",
    "HONO_TRUSTED_ORIGINS",
    "HONO_WEB_URL",
    "INTERNAL_API_URL",
    "POSTGRES_URL",
    "RAZORPAY_CREDENTIAL_KEY",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    // Client variables
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "NEXT_PUBLIC_USERJOT_URL"
  ],
  "globalPassThroughEnv": ["PORTLESS", "PORTLESS_HTTPS", "PORTLESS_PORT", "PORTLESS_SYNC_HOSTS"]
}
