{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "experimentalSortImports": {},
  "experimentalTailwindcss": {},
  // data/ holds generated run reports. lint-staged runs oxfmt over every staged file, which
  // reflows their arrays and leaves the committed copy no longer byte-identical to what the
  // script wrote - so re-running a script to verify a number reports a diff that is pure
  // formatting noise. These files are script output, not source: leave them exactly as written.
  "ignorePatterns": [".agents/**", "data/**"],
}
